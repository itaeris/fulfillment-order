# Backend NestJS — copy ke `apps/api/.env`
# Jangan commit. Isi yang sama di GitHub Secret BACKEND_ENV.

API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:2022,https://fulfillment-fti.aerisbeaute.com

# ── MySQL (container yang sudah running) ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fulfillment_db
MYSQL_USER=root
MYSQL_PASSWORD=

# ── Redis (container yang sudah running, bukan Upstash) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

DASHBOARD_CACHE_TTL=45
