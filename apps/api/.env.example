# Backend NestJS — copy ke `apps/api/.env`
# Jangan commit. Frontend Next: lihat `.env.example` di root repo.
# File ini yang diisi di Vercel project API (Root Directory: apps/api).

API_PORT=4000
# Origin frontend yang boleh hit API, pisah koma.
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://fulfillment-fti.aerisbeaute.com

# ── Supabase (server Nest) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Upstash Redis (cache dashboard, local + Vercel) ──
DASHBOARD_CACHE_TTL=45
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
