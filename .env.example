# Frontend / Next.js — copy ke `.env` di ROOT repo.
# Jangan commit. Backend Nest: lihat `apps/api/.env.example`.

# ── Supabase (browser + API routes Next) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── TikTok Shop Open API ──
# `sign` & `timestamp` tidak disimpan di sini — dihitung per-request.
# Access token kadaluarsa ~4 jam; app memperbarui otomatis via refresh_token
# setelah toko dihubungkan (Settings → Hubungkan TikTok).
# Redirect URL di aplikasi TikTok: {origin}/api/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_CIPHER=
TIKTOK_SERVICE_ID=
TIKTOK_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_API_VERSION=202309
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_REDIRECT_ORIGIN=
TIKTOK_AUTHORIZE_URL=

# ── Shopee Open API v2 ──
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_BASE_URL=https://partner.shopeemobile.com
SHOPEE_SHOP_ID=
SHOPEE_REDIRECT_ORIGIN=

# ── Jubelio WMS / Omnichannel API ──
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
JUBELIO_BASE_URL=https://api2.jubelio.com
JUBELIO_LOCATION_NAME=Gudang Finished Goods
JUBELIO_LOCATION_ID=
JUBELIO_WEBHOOK_SECRET=
JUBELIO_WEBHOOK_FORWARD_URL=

# ── Cloudflare Turnstile (login + reset password) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── URL Nest API ──
# Lokal: http://localhost:4000
# Vercel project WEB: jangan pakai localhost.
# Kosongkan sampai project API jadi, lalu isi URL Nest (https://....vercel.app)
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
