# Copy to `.env` or `.env.local` and isi nilainya.
# Jangan commit file yang berisi secret.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── TikTok Shop Open API ──
# `sign` & `timestamp` tidak disimpan di sini — dihitung per-request.
# Access token kadaluarsa ~4 jam; app memperbarui otomatis via refresh_token
# setelah toko dihubungkan (Settings → Hubungkan TikTok).
# Redirect URL di aplikasi TikTok: {origin}/api/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_CIPHER=
TIKTOK_SERVICE_ID=
TIKTOK_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_API_VERSION=202309
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
# Opsional. Token biasanya disimpan di Supabase setelah Hubungkan TikTok.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Opsional. Paksa origin callback (contoh: https://fulfillment-fti.aerisbeaute.com)
TIKTOK_REDIRECT_ORIGIN=
# Opsional. Override URL authorize dari Partner Center ("Copy authorization link")
TIKTOK_AUTHORIZE_URL=

# ── Shopee Open API v2 ──
# Partner ID + Partner Key dari Open Platform (App Key, Live).
# Access token ~4 jam; refresh ~30 hari. App memperbarui otomatis
# setelah toko dihubungkan (Settings → Hubungkan Shopee).
# Redirect domain di console Shopee: {origin}
# Callback app: {origin}/api/shopee/callback
# Auth: https://open.shopee.com/developer-guide/20
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_BASE_URL=https://partner.shopeemobile.com
# Opsional. Kalau callback SIP tidak mengembalikan shop_id.
SHOPEE_SHOP_ID=
# Opsional. Paksa origin callback (contoh: https://fulfillment-fti.aerisbeaute.com)
SHOPEE_REDIRECT_ORIGIN=

# ── Jubelio WMS / Omnichannel API ──
# Token dari POST /login, kadaluarsa 12 jam — app login ulang otomatis.
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
JUBELIO_BASE_URL=https://api2.jubelio.com
JUBELIO_LOCATION_NAME=Gudang Finished Goods
# Opsional. Kalau diisi, dipakai sebagai lokasi WMS (bukan nama).
JUBELIO_LOCATION_ID=
JUBELIO_WEBHOOK_SECRET=
# Opsional. URL webhook lama (bisa lebih dari satu, pisah koma).
JUBELIO_WEBHOOK_FORWARD_URL=

# ── Cloudflare Turnstile (login + request reset password) ──
# Production: site key + secret dari Cloudflare Dashboard → Turnstile.
# Hostname widget harus include domain live (fulfillment-fti.aerisbeaute.com).
# Local: dummy always-pass di bawah, ATAU widget terpisah dengan hostname localhost.
# Dummy (hanya local, jangan di Vercel):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
